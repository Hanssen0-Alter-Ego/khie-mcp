@@ -0,0 +1,151 @@
+import { randomBytes, randomUUID } from "node:crypto";
+import { chmod, mkdtemp, rm, writeFile } from "node:fs/promises";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import type { KhieBridge } from "./bridge.js";
+import { runReadProbe } from "./readProbe.js";
+import { createHttpServer } from "./server.js";
+import type { Outcome } from "./state.js";
+
+const cleanup: (() => Promise<unknown>)[] = [];
+afterEach(async () => {
+  for (const close of cleanup.splice(0).reverse()) {
+    await close();
+  }
+});
+
+async function fixture() {
+  const directory = await mkdtemp(join(tmpdir(), "khie-read-probe-test-"));
+  cleanup.push(() => rm(directory, { recursive: true, force: true }));
+  const token = randomBytes(32).toString("base64url");
+  const handle = randomUUID();
+  const bridge = {
+    request: vi.fn(async (): Promise<Outcome> => ({
+      status: "completed",
+      result: "arbitrary-test-identity",
+    })),
+    poll: vi.fn(async (): Promise<Outcome> => ({ status: "pending" })),
+  };
+  const hosts = ["placeholder"];
+  const server = createHttpServer(bridge as unknown as KhieBridge, {
+    principal: "read-probe-test",
+    bearerToken: token,
+    allowedHosts: hosts,
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const endpoint = `http://127.0.0.1:${(server.address() as AddressInfo).port}/mcp`;
+  hosts.push(new URL(endpoint).host);
+  cleanup.push(
+    () =>
+      new Promise<void>((resolve, reject) => {
+        server.close((error) => (error ? reject(error) : resolve()));
+        server.closeAllConnections();
+      }),
+  );
+  const file = join(directory, "client.json");
+  const config = { handle, token, endpoint };
+  await writeFile(file, JSON.stringify(config), { mode: 0o600 });
+  return { bridge, handle, file, config };
+}
+
+it("uses real MCP initialization and discovery for one read, preserving the supplied ID", async () => {
+  const f = await fixture();
+  expect(
+    await runReadProbe(f.file, "request", "mobile-read-001", "get_identity"),
+  ).toEqual({
+    status: "completed",
+    result: "arbitrary-test-identity",
+  });
+  expect(f.bridge.request).toHaveBeenCalledExactlyOnceWith(
+    "read-probe-test",
+    f.handle,
+    "mobile-read-001",
+    "get_identity",
+    [],
+  );
+  expect(f.bridge.poll).not.toHaveBeenCalled();
+});
+
+it("polls in a fresh SDK client without sending another wallet request", async () => {
+  const f = await fixture();
+  expect(await runReadProbe(f.file, "poll", "pending-read-001")).toEqual({
+    status: "pending",
+  });
+  f.bridge.poll.mockResolvedValueOnce({
+    status: "unknown",
+    reason: "not_found",
+  });
+  expect(await runReadProbe(f.file, "poll", "pending-read-001")).toEqual({
+    status: "unknown",
+    reason: "not_found",
+  });
+  expect(f.bridge.request).not.toHaveBeenCalled();
+  expect(f.bridge.poll).toHaveBeenNthCalledWith(
+    1,
+    "read-probe-test",
+    f.handle,
+    "pending-read-001",
+  );
+  expect(f.bridge.poll).toHaveBeenNthCalledWith(
+    2,
+    "read-probe-test",
+    f.handle,
+    "pending-read-001",
+  );
+});
+
+it("rejects signing, transaction methods and invalid IDs before opening the credential file", async () => {
+  for (const method of ["sign_message", "send_transaction", "connect"]) {
+    await expect(
+      runReadProbe("missing", "request", "read-001", method),
+    ).rejects.toMatchObject({ code: "invalid_probe_arguments" });
+  }
+  await expect(
+    runReadProbe("missing", "poll", "_connect"),
+  ).rejects.toMatchObject({ code: "invalid_operation_id" });
+  await expect(
+    runReadProbe("missing", "poll", "read-001", "get_identity"),
+  ).rejects.toMatchObject({ code: "invalid_probe_arguments" });
+});
+
+it("fails closed on nonlocal credential destinations and unsafe file permissions", async () => {
+  const f = await fixture();
+  await writeFile(
+    f.file,
+    JSON.stringify({ ...f.config, endpoint: "https://example.invalid/mcp" }),
+  );
+  await expect(
+    runReadProbe(f.file, "request", "read-001", "get_identity"),
+  ).rejects.toMatchObject({ code: "read_probe_failed" });
+  const unsafe = `${f.file}.unsafe`;
+  await writeFile(unsafe, JSON.stringify(f.config), { mode: 0o644 });
+  // A restrictive process umask may remove these bits during creation.
+  await chmod(unsafe, 0o644);
+  await expect(
+    runReadProbe(unsafe, "request", "read-001", "get_identity"),
+  ).rejects.toMatchObject({ code: "read_probe_failed" });
+  expect(f.bridge.request).not.toHaveBeenCalled();
+});
+
+it("suppresses authentication and raw adapter errors", async () => {
+  const f = await fixture();
+  await writeFile(
+    f.file,
+    JSON.stringify({
+      ...f.config,
+      token: randomBytes(32).toString("base64url"),
+    }),
+  );
+  await expect(
+    runReadProbe(f.file, "request", "read-001", "get_identity"),
+  ).rejects.toThrow(/^read_probe_failed$/);
+  await writeFile(f.file, JSON.stringify(f.config));
+  f.bridge.request.mockRejectedValueOnce(
+    new Error(`private-token:${f.config.token}`),
+  );
+  expect(
+    await runReadProbe(f.file, "request", "read-001", "get_identity"),
+  ).toEqual({ error: "bridge_unavailable" });
+});
diff --git a/packages/khie-mcp/src/readProbe.ts b/packages/khie-mcp/src/readProbe.ts
new file mode 100644
index 0000000..0980689
--- /dev/null
+++ b/packages/khie-mcp/src/readProbe.ts
@@ -0,0 +1,106 @@
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+import { pathToFileURL } from "node:url";
+import { z } from "zod";
+import { readSecretFile } from "./cli.js";
+import { BridgeError, validateOperationId } from "./state.js";
+
+const configSchema = z
+  .object({
+    endpoint: z.string().url(),
+    handle: z.string().uuid(),
+    token: z.string().min(32),
+  })
+  .strict();
+const readMethods = ["get_identity", "get_native_address", "get_scripts"];
+
+/** Operator-only, one-call local probe. Never generates IDs or retries a request. */
+export async function runReadProbe(
+  configPath: string,
+  mode: string,
+  operationId: string,
+  method?: string,
+) {
+  validateOperationId(operationId);
+  if (
+    (mode !== "request" && mode !== "poll") ||
+    (mode === "request" && !readMethods.includes(method ?? "")) ||
+    (mode === "poll" && method !== undefined)
+  ) {
+    throw new BridgeError("invalid_probe_arguments");
+  }
+  let client: Client | undefined;
+  try {
+    const config = configSchema.parse(
+      JSON.parse(await readSecretFile(configPath)),
+    );
+    const url = new URL(config.endpoint);
+    // This mobile readiness client is deliberately local. The synthetic smoke
+    // client remains the separate entry point for approved public tunnel tests.
+    if (
+      url.protocol !== "http:" ||
+      url.hostname !== "127.0.0.1" ||
+      url.pathname !== "/mcp" ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    ) {
+      throw new Error("Invalid local endpoint");
+    }
+    client = new Client({ name: "khie-read-only-probe", version: "0.0.0" });
+    await client.connect(
+      new StreamableHTTPClientTransport(url, {
+        requestInit: { headers: { Authorization: `Bearer ${config.token}` } },
+      }),
+    );
+    if (client.getServerVersion()?.name !== "khie-mcp-prototype") {
+      throw new Error("Unexpected server");
+    }
+    const names = (await client.listTools()).tools.map(({ name }) => name);
+    if (!names.includes("khie_request") || !names.includes("khie_get_result")) {
+      throw new Error("Missing tools");
+    }
+    const result = await client.callTool({
+      name: mode === "poll" ? "khie_get_result" : "khie_request",
+      arguments: {
+        handle: config.handle,
+        operation_id: operationId,
+        ...(mode === "request" ? { method, params: [] } : {}),
+      },
+    });
+    const content = result.content as { type: string; text?: string }[];
+    if (
+      content.length !== 1 ||
+      content[0].type !== "text" ||
+      !content[0].text
+    ) {
+      throw new Error("Invalid response");
+    }
+    return JSON.parse(content[0].text) as unknown;
+  } catch {
+    // SDK, config and transport errors can echo Authorization or provisioning data.
+    throw new BridgeError("read_probe_failed");
+  } finally {
+    await client?.close().catch(() => {});
+  }
+}
+
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(process.argv[1]).href
+) {
+  const [config, mode, operationId, method, ...extra] = process.argv.slice(2);
+  if (!config || !mode || !operationId || extra.length) {
+    console.error("use_read_probe_CONFIG_request_ID_METHOD_or_CONFIG_poll_ID");
+    process.exitCode = 1;
+  } else {
+    void runReadProbe(config, mode, operationId, method).then(
+      (outcome) => console.log(JSON.stringify(outcome)),
+      () => {
+        console.error("read_probe_failed");
+        process.exitCode = 1;
+      },
+    );
+  }
+}
