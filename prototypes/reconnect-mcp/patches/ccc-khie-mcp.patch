+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+import { randomBytes, randomUUID } from "node:crypto";
+import { request } from "node:http";
+import type { AddressInfo } from "node:net";
+import { afterEach, expect, it, vi } from "vitest";
+import type { KhieBridge } from "./bridge.js";
+import { createHttpServer } from "./server.js";
+
+const cleanup: (() => Promise<unknown>)[] = [];
+afterEach(async () => {
+  for (const close of cleanup.splice(0).reverse()) {
+    await close();
+  }
+});
+
+async function fixture() {
+  const token = randomBytes(32).toString("base64url");
+  const bridge = {
+    request: vi.fn(async () => ({
+      status: "completed",
+      result: "test-result",
+    })),
+    poll: vi.fn(async () => ({ status: "pending" })),
+  };
+  const hosts: string[] = ["placeholder"];
+  const server = createHttpServer(bridge as unknown as KhieBridge, {
+    principal: "test-principal",
+    bearerToken: token,
+    allowedHosts: hosts,
+  });
+  await new Promise<void>((resolve) => {
+    server.listen(0, "127.0.0.1", resolve);
+  });
+  const url = new URL(
+    `http://127.0.0.1:${(server.address() as AddressInfo).port}/mcp`,
+  );
+  hosts.push(url.host);
+  cleanup.push(
+    () =>
+      new Promise<void>((resolve, reject) => {
+        server.close((error) => (error ? reject(error) : resolve()));
+        server.closeAllConnections();
+      }),
+  );
+  return { token, bridge, url };
+}
+
+it("initializes an independent SDK client and lists/calls the two bounded tools", async () => {
+  const f = await fixture();
+  const client = new Client({
+    name: "independent-test-client",
+    version: "1.0.0",
+  });
+  const transport = new StreamableHTTPClientTransport(f.url, {
+    requestInit: { headers: { Authorization: `Bearer ${f.token}` } },
+  });
+  await client.connect(transport);
+  cleanup.push(() => client.close());
+  expect(client.getServerVersion()?.name).toBe("khie-mcp-prototype");
+  expect((await client.listTools()).tools.map(({ name }) => name)).toEqual([
+    "khie_request",
+    "khie_get_result",
+  ]);
+  const handle = randomUUID();
+  const result = await client.callTool({
+    name: "khie_request",
+    arguments: { handle, operation_id: "read-1", method: "get_identity" },
+  });
+  expect(result.content).toEqual([
+    {
+      type: "text",
+      text: JSON.stringify({ status: "completed", result: "test-result" }),
+    },
+  ]);
+  expect(f.bridge.request).toHaveBeenCalledWith(
+    "test-principal",
+    handle,
+    "read-1",
+    "get_identity",
+    [],
+  );
+  expect(
+    await client.callTool({
+      name: "khie_get_result",
+      arguments: { handle, operation_id: "read-1" },
+    }),
+  ).toMatchObject({ content: [{ text: '{"status":"pending"}' }] });
+  const forbidden = await client.callTool({
+    name: "khie_request",
+    arguments: {
+      handle,
+      operation_id: "forbidden",
+      method: "send_transaction",
+      session_id: "must-not-accept",
+    },
+  });
+  expect(forbidden.isError).toBe(true);
+  expect(f.bridge.request).toHaveBeenCalledTimes(1);
+});
+
+it("requires authentication and rejects browser origins, bad hosts, and non-POST transport", async () => {
+  const f = await fixture();
+  expect((await fetch(f.url)).status).toBe(401);
+  const headers = { Authorization: `Bearer ${f.token}` };
+  expect((await fetch(f.url, { headers })).status).toBe(405);
+  expect(
+    (
+      await fetch(f.url, {
+        headers: { ...headers, Origin: "https://untrusted.example" },
+      })
+    ).status,
+  ).toBe(403);
+  // fetch normalizes Host; use a raw HTTP client for the rebinding check.
+  const badHostStatus = await new Promise<number | undefined>(
+    (resolve, reject) => {
+      const req = request(
+        f.url,
+        { headers: { ...headers, Host: "untrusted.example" } },
+        (res) => {
+          res.resume();
+          resolve(res.statusCode);
+        },
+      );
+      req.on("error", reject);
+      req.end();
+    },
+  );
+  expect(badHostStatus).toBe(403);
+  expect((await fetch(new URL("/wallet-rpc", f.url), { headers })).status).toBe(
+    404,
+  );
+  expect(f.bridge.request).not.toHaveBeenCalled();
+});
+
+it("does not expose raw adapter errors through MCP", async () => {
+  const f = await fixture();
+  f.bridge.request.mockRejectedValue(
+    new Error("private communication key and session data"),
+  );
+  const client = new Client({ name: "error-test", version: "1" });
+  await client.connect(
+    new StreamableHTTPClientTransport(f.url, {
+      requestInit: { headers: { Authorization: `Bearer ${f.token}` } },
+    }),
+  );
+  cleanup.push(() => client.close());
+  const result = await client.callTool({
+    name: "khie_request",
+    arguments: {
+      handle: randomUUID(),
+      operation_id: "error",
+      method: "get_identity",
+    },
+  });
+  expect(result).toMatchObject({
+    isError: true,
+    content: [{ text: '{"error":"bridge_unavailable"}' }],
+  });
+});
diff --git a/packages/khie-mcp/src/server.ts b/packages/khie-mcp/src/server.ts
new file mode 100644
index 0000000..538670b
--- /dev/null
+++ b/packages/khie-mcp/src/server.ts
@@ -0,0 +1,199 @@
+import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js";
+import { createHash, timingSafeEqual } from "node:crypto";
+import { createServer, type IncomingMessage } from "node:http";
+import { z } from "zod";
+import type { KhieBridge } from "./bridge.js";
+import { BridgeError, METHODS } from "./state.js";
+
+export type ServerConfig = {
+  /** One principal/token per prototype server. Handles are not credentials. */
+  principal: string;
+  bearerToken: string;
+  allowedHosts: string[];
+};
+
+export function createMcpServer(bridge: KhieBridge, principal: string) {
+  const server = new McpServer({
+    name: "khie-mcp-prototype",
+    version: "0.0.0",
+  });
+  const identifiers = {
+    handle: z
+      .string()
+      .uuid()
+      .describe("Opaque operator-provisioned wallet handle"),
+    operation_id: z
+      .string()
+      .regex(/^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$/)
+      .describe(
+        "Reuse for retries of the same intent; never change to bypass an unknown outcome",
+      ),
+  };
+  server.registerTool(
+    "khie_request",
+    {
+      description:
+        "Request from the user's online Khie wallet. Wallet approvals remain in the wallet. Reuse operation_id for retries; unknown never means not executed. Transactions are not supported.",
+      inputSchema: z
+        .object({
+          ...identifiers,
+          method: z.enum(METHODS),
+          params: z
+            .array(
+              z.discriminatedUnion("type", [
+                z
+                  .object({ type: z.literal("string"), value: z.string() })
+                  .strict(),
+                z
+                  .object({
+                    type: z.literal("bytes"),
+                    value: z.string().regex(/^0x([0-9a-fA-F]{2})*$/),
+                  })
+                  .strict(),
+              ]),
+            )
+            .max(1)
+            .default([]),
+        })
+        .strict(),
+      annotations: {
+        readOnlyHint: false,
+        destructiveHint: false,
+        idempotentHint: true,
+        openWorldHint: true,
+      },
+    },
+    async ({ handle, operation_id, method, params }) =>
+      toolResult(() =>
+        bridge.request(principal, handle, operation_id, method, params),
+      ),
+  );
+  server.registerTool(
+    "khie_get_result",
+    {
+      description:
+        "Poll a previously recorded operation. Pending may need wallet confirmation. An unknown/not_found outcome may have executed and must not be automatically submitted again.",
+      inputSchema: z.object(identifiers).strict(),
+      annotations: {
+        readOnlyHint: true,
+        idempotentHint: true,
+        openWorldHint: true,
+      },
+    },
+    async ({ handle, operation_id }) =>
+      toolResult(() => bridge.poll(principal, handle, operation_id)),
+  );
+  return server;
+}
+
+async function toolResult(run: () => Promise<unknown>) {
+  try {
+    const result = await run();
+    return {
+      content: [{ type: "text" as const, text: JSON.stringify(result) }],
+    };
+  } catch (error) {
+    // Do not forward wallet, transport, file, SDK, or credential error messages.
+    return {
+      isError: true,
+      content: [
+        {
+          type: "text" as const,
+          text: JSON.stringify({
+            error:
+              error instanceof BridgeError ? error.code : "bridge_unavailable",
+          }),
+        },
+      ],
+    };
+  }
+}
+
+/** Stateless Streamable HTTP, JSON responses (no SSE needed by quick tunnels). */
+export function createHttpServer(bridge: KhieBridge, config: ServerConfig) {
+  if (
+    config.bearerToken.length < 32 ||
+    !config.principal ||
+    !config.allowedHosts.length
+  ) {
+    throw new BridgeError("invalid_server_config");
+  }
+  const expected = hash(config.bearerToken);
+  let active = 0;
+  const server = createServer(async (request, response) => {
+    response.setHeader("Cache-Control", "no-store");
+    response.setHeader("X-Content-Type-Options", "nosniff");
+    if (
+      !config.allowedHosts.includes(request.headers.host ?? "") ||
+      request.headers.origin !== undefined
+    ) {
+      response.writeHead(403).end();
+      return;
+    }
+    const token = request.headers.authorization?.replace(/^Bearer /, "") ?? "";
+    if (
+      !request.headers.authorization?.startsWith("Bearer ") ||
+      !timingSafeEqual(expected, hash(token))
+    ) {
+      response.writeHead(401).end();
+      return;
+    }
+    if (request.url !== "/mcp") {
+      response.writeHead(404).end();
+      return;
+    }
+    if (request.method !== "POST") {
+      response.writeHead(405, { Allow: "POST" }).end();
+      return;
+    }
+    if (!request.headers["content-type"]?.startsWith("application/json")) {
+      response.writeHead(415).end();
+      return;
+    }
+    if (active >= 8) {
+      response.writeHead(429).end();
+      return;
+    }
+    active++;
+    let mcp: McpServer | undefined;
+    try {
+      const body = await readBody(request);
+      mcp = createMcpServer(bridge, config.principal);
+      const transport = new StreamableHTTPServerTransport({
+        sessionIdGenerator: undefined,
+        enableJsonResponse: true,
+      });
+      await mcp.connect(transport);
+      await transport.handleRequest(request, response, body);
+    } catch {
+      if (!response.headersSent) {
+        response.writeHead(400).end();
+      }
+    } finally {
+      await mcp?.close();
+      active--;
+    }
+  });
+  server.requestTimeout = 30_000;
+  server.headersTimeout = 10_000;
+  return server;
+}
+
+function hash(value: string) {
+  return createHash("sha256").update(value).digest();
+}
+
+async function readBody(request: IncomingMessage) {
+  const chunks: Buffer[] = [];
+  let length = 0;
+  for await (const chunk of request) {
+    const buffer = Buffer.from(chunk as Uint8Array);
+    length += buffer.length;
+    if (length > 64 * 1024) {
+      throw new Error("Body too large");
+    }
+    chunks.push(buffer);
+  }
+  return JSON.parse(Buffer.concat(chunks).toString()) as unknown;
+}
diff --git a/packages/khie-mcp/src/smoke.ts b/packages/khie-mcp/src/smoke.ts
new file mode 100644
index 0000000..0ef09b8
--- /dev/null
+++ b/packages/khie-mcp/src/smoke.ts
@@ -0,0 +1,101 @@
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { readSecretFile } from "./cli.js";
+
+async function main() {
+  const config = JSON.parse(await readSecretFile(process.argv[2])) as {
+    handle: string;
+    token: string;
+    endpoint: string;
+  };
+  const endpoint = new URL(process.argv[3] ?? config.endpoint);
+  assert(endpoint.protocol === "https:" || endpoint.hostname === "127.0.0.1");
+  const unauthorized = await fetch(endpoint);
+  assert.equal(unauthorized.status, 401);
+  const client = new Client({
+    name: "khie-independent-smoke",
+    version: "0.0.0",
+  });
+  const transport = new StreamableHTTPClientTransport(endpoint, {
+    requestInit: { headers: { Authorization: `Bearer ${config.token}` } },
+  });
+  try {
+    await client.connect(transport);
+    assert.equal(client.getServerVersion()?.name, "khie-mcp-prototype");
+    assert.deepEqual(
+      (await client.listTools()).tools.map((tool) => tool.name),
+      ["khie_request", "khie_get_result"],
+    );
+    const call = async (name: string, args: Record<string, unknown>) => {
+      const result = await client.callTool({
+        name,
+        arguments: { handle: config.handle, ...args },
+      });
+      const content = result.content as { type: string; text: string }[];
+      return JSON.parse(content[0].text) as {
+        status?: string;
+        reason?: string;
+        result?: unknown;
+        error?: string;
+      };
+    };
+    const operation_id = randomUUID();
+    const first = await call("khie_request", {
+      operation_id,
+      method: "get_identity",
+    });
+    assert.deepEqual(first, {
+      status: "completed",
+      result: "synthetic-wallet-identity",
+    });
+    assert.deepEqual(
+      await call("khie_request", { operation_id, method: "get_identity" }),
+      first,
+    );
+    const signingId = randomUUID();
+    const initial = await call("khie_request", {
+      operation_id: signingId,
+      method: "sign_message",
+      params: [{ type: "string", value: "synthetic smoke test only" }],
+    });
+    assert.equal(initial.status, "unknown");
+    const mismatch = await call("khie_request", {
+      operation_id: signingId,
+      method: "sign_message",
+      params: [{ type: "string", value: "different request" }],
+    });
+    assert.equal(mismatch.error, "operation_payload_mismatch");
+    const pending = await call("khie_get_result", { operation_id: signingId });
+    assert.equal(pending.status, "pending");
+    const completed = await call("khie_get_result", {
+      operation_id: signingId,
+    });
+    assert.deepEqual(completed, {
+      status: "completed",
+      result: "synthetic-signature-not-valid-on-any-chain",
+    });
+    console.log(
+      JSON.stringify({
+        initialize: "passed",
+        tools: "passed",
+        authentication: "passed",
+        requestAndRetry: "passed",
+        mismatchedPayload: "passed",
+        pendingThenCompleted: "passed",
+        wallet: "synthetic loopback peer",
+        hostConnectorIntegration: "not tested",
+      }),
+    );
+  } finally {
+    await client.close();
+  }
+}
+
+void main().catch(() => {
+  console.error(
+    "smoke_failed (credentials and raw transport errors suppressed)",
+  );
+  process.exitCode = 1;
+});
diff --git a/packages/khie-mcp/src/state.ts b/packages/khie-mcp/src/state.ts
new file mode 100644
index 0000000..f1d1b47
--- /dev/null
+++ b/packages/khie-mcp/src/state.ts
@@ -0,0 +1,67 @@
+export const METHODS = [
+  "get_identity",
+  "get_native_address",
+  "get_scripts",
+  "sign_message",
+] as const;
+export type Method = (typeof METHODS)[number];
+
+export type Outcome =
+  | { status: "completed"; result: unknown }
+  | { status: "pending" }
+  | {
+      status: "unknown";
+      reason: "transport" | "not_found" | "invalid_response" | "wallet_error";
+    }
+  | { status: "rejected"; code: number }
+  | { status: "repair_required" };
+
+export type Operation = {
+  fingerprint: string;
+  /** Persisted before sending. Never replaced or automatically re-dispatched. */
+  requestId: string;
+  outcome?: Outcome;
+};
+
+/** Secret operator-side data. Never a tool argument, result, or log entry. */
+export type WalletState = {
+  version: 1;
+  principal: string;
+  /** Protobuf libp2p communication private key, NOT a wallet asset key. */
+  communicationKey: string;
+  walletPeerId: string;
+  walletAddresses: string[];
+  sessionId?: string;
+  networkId: string;
+  phase: "pairing" | "paired" | "authorized" | "repair_required";
+  allowedMethods: Method[];
+  operations: Record<string, Operation>;
+};
+
+/**
+ * A production implementation belongs outside the model/worker trust boundary.
+ * Encrypt secrets/results, bind handles to authenticated principals, and provide
+ * exclusive execution across workers. save() MUST durably commit before resolving.
+ * Never automatically expire locks or discard operation tombstones: a crashed
+ * sender may have executed. Fenced recovery requires proving the old worker dead.
+ */
+export interface SecureStateStore {
+  create(state: WalletState): Promise<string>;
+  withSession<T>(
+    principal: string,
+    handle: string,
+    use: (state: WalletState, save: () => Promise<void>) => Promise<T>,
+  ): Promise<T>;
+}
+
+export class BridgeError extends Error {
+  constructor(readonly code: string) {
+    super(code);
+  }
+}
+
+export function validateOperationId(id: string) {
+  if (!/^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$/.test(id)) {
+    throw new BridgeError("invalid_operation_id");
+  }
+}
diff --git a/packages/khie-mcp/src/store.ts b/packages/khie-mcp/src/store.ts
new file mode 100644
index 0000000..364326d
--- /dev/null
+++ b/packages/khie-mcp/src/store.ts
@@ -0,0 +1,146 @@
+import {
+  createCipheriv,
+  createDecipheriv,
+  randomBytes,
+  randomUUID,
+} from "node:crypto";
+import { constants } from "node:fs";
+import { lstat, mkdir, open, rename, rm } from "node:fs/promises";
+import { resolve } from "node:path";
+import {
+  BridgeError,
+  type SecureStateStore,
+  type WalletState,
+} from "./state.js";
+
+/** Local POSIX prototype adapter; use a KMS-backed transactional store remotely. */
+export class FileSecureStateStore implements SecureStateStore {
+  private constructor(
+    private readonly directory: string,
+    private readonly key: Buffer,
+  ) {}
+
+  static async open(directory: string, key: Buffer) {
+    if (key.length !== 32) {
+      throw new BridgeError("invalid_store_key");
+    }
+    const path = resolve(directory);
+    await mkdir(path, { recursive: true, mode: 0o700 });
+    const stat = await lstat(path);
+    if (
+      !stat.isDirectory() ||
+      stat.isSymbolicLink() ||
+      (stat.mode & 0o077) !== 0 ||
+      stat.uid !== process.getuid?.()
+    ) {
+      throw new BridgeError("unsafe_store_directory");
+    }
+    return new FileSecureStateStore(path, Buffer.from(key));
+  }
+
+  async create(state: WalletState) {
+    const handle = randomUUID();
+    await this.write(handle, state);
+    return handle;
+  }
+
+  async withSession<T>(
+    principal: string,
+    handle: string,
+    use: (state: WalletState, save: () => Promise<void>) => Promise<T>,
+  ): Promise<T> {
+    if (
+      !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(
+        handle,
+      )
+    ) {
+      throw new BridgeError("unknown_handle");
+    }
+    const lock = `${this.directory}/${handle}.lock`;
+    try {
+      await mkdir(lock, { mode: 0o700 });
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "EEXIST") {
+        throw new BridgeError("session_busy");
+      }
+      throw error;
+    }
+    let quarantined = false;
+    try {
+      const state = await this.read(handle);
+      if (state.principal !== principal) {
+        throw new BridgeError("unknown_handle");
+      }
+      return await use(state, () => this.write(handle, state));
+    } catch (error) {
+      quarantined =
+        error instanceof BridgeError &&
+        error.code === "transport_cleanup_failed";
+      throw error;
+    } finally {
+      if (!quarantined) {
+        await rm(lock, { recursive: true });
+      }
+    }
+  }
+
+  private async read(handle: string): Promise<WalletState> {
+    try {
+      const file = await open(
+        `${this.directory}/${handle}.sealed`,
+        constants.O_RDONLY | constants.O_NOFOLLOW,
+      );
+      try {
+        const bytes = await file.readFile();
+        const decipher = createDecipheriv(
+          "aes-256-gcm",
+          this.key,
+          bytes.subarray(0, 12),
+        );
+        decipher.setAAD(Buffer.from(handle));
+        decipher.setAuthTag(bytes.subarray(12, 28));
+        const state = JSON.parse(
+          Buffer.concat([
+            decipher.update(bytes.subarray(28)),
+            decipher.final(),
+          ]).toString(),
+        ) as WalletState;
+        if (state.version !== 1) {
+          throw new Error("Unsupported state");
+        }
+        return state;
+      } finally {
+        await file.close();
+      }
+    } catch {
+      throw new BridgeError("unknown_handle");
+    }
+  }
+
+  private async write(handle: string, state: WalletState) {
+    const nonce = randomBytes(12);
+    const cipher = createCipheriv("aes-256-gcm", this.key, nonce);
+    cipher.setAAD(Buffer.from(handle));
+    const ciphertext = Buffer.concat([
+      cipher.update(JSON.stringify(state)),
+      cipher.final(),
+    ]);
+    const temp = `${this.directory}/${handle}.${randomUUID()}.tmp`;
+    const file = await open(temp, "wx", 0o600);
+    try {
+      await file.writeFile(
+        Buffer.concat([nonce, cipher.getAuthTag(), ciphertext]),
+      );
+      await file.sync();
+    } finally {
+      await file.close();
+    }
+    await rename(temp, `${this.directory}/${handle}.sealed`);
+    const directory = await open(this.directory, "r");
+    try {
+      await directory.sync();
+    } finally {
+      await directory.close();
+    }
+  }
+}
diff --git a/packages/khie-mcp/src/testWallet.ts b/packages/khie-mcp/src/testWallet.ts
new file mode 100644
index 0000000..4eee9fc
--- /dev/null
+++ b/packages/khie-mcp/src/testWallet.ts
@@ -0,0 +1,157 @@
+// Isolated test fixture. No asset keys, chain calls, signing, or broadcast.
+import { noise } from "@chainsafe/libp2p-noise";
+import { yamux } from "@chainsafe/libp2p-yamux";
+import { ccc } from "@ckb-ccc/core";
+import { Libp2p } from "@ckb-ccc/libp2p";
+import { identify } from "@libp2p/identify";
+import type {
+  Libp2p as Libp2pNode,
+  PeerId,
+  PrivateKey,
+} from "@libp2p/interface";
+import { webSockets } from "@libp2p/websockets";
+import { createLibp2p } from "libp2p";
+import {
+  createBridgeNode,
+  JSON_RPC_PROTOCOL,
+  PAIRING_PROTOCOL,
+  type BridgeNode,
+} from "./transport.js";
+
+export async function createTestBridgeNode(
+  privateKey: PrivateKey,
+): Promise<BridgeNode> {
+  return createBridgeNode(privateKey);
+}
+
+type TestWallet = {
+  node: Libp2pNode<{ pairing: Libp2p.PairingService }>;
+  stats: {
+    authorizations: number;
+    signatures: number;
+    unpairs: number;
+    peers: string[];
+    methods: string[];
+  };
+  endpoint: string;
+  selectedPeer: PeerId | undefined;
+  releaseSignature(): void;
+  restartSession(): Promise<void>;
+  stop(): Promise<void>;
+};
+
+export async function createTestWallet(
+  options: { pairedPeerTimeoutMs?: number; signDelayMs?: number } = {},
+): Promise<TestWallet> {
+  const stats = {
+    authorizations: 0,
+    signatures: 0,
+    unpairs: 0,
+    peers: [] as string[],
+    methods: [] as string[],
+  };
+  let releaseSignature: (() => void) | undefined;
+  let signatureTimer: ReturnType<typeof setTimeout> | undefined;
+  const signer = {
+    client: { addressPrefix: "ckt" },
+    type: ccc.SignerType.CKB,
+    signType: ccc.SignerSignType.CkbSecp256k1,
+    getIdentity: async () => "synthetic-wallet-identity",
+    getInternalAddress: async () => "synthetic-wallet-address",
+    getAddressObjs: async () => [],
+    signMessageRaw: async () => {
+      stats.signatures++;
+      await new Promise<void>((resolve) => {
+        releaseSignature = resolve;
+        if (options.signDelayMs !== undefined) {
+          signatureTimer = setTimeout(resolve, options.signDelayMs);
+        }
+      });
+      return "synthetic-signature-not-valid-on-any-chain";
+    },
+  } as unknown as ccc.Signer;
+  const createSession = () =>
+    ccc.SignerJsonRpcProviderSession.open({
+      getSigner: () => signer,
+      connect: async () => signer,
+      confirmRequest: async (request) => {
+        if (request.method === "connect") {
+          stats.authorizations++;
+        }
+        return true;
+      },
+    });
+  let session = createSession();
+  let selectedPeer: PeerId | undefined;
+  const node = await createLibp2p({
+    addresses: { listen: ["/ip4/127.0.0.1/tcp/0/ws"] },
+    transports: [webSockets()],
+    connectionEncrypters: [noise()],
+    streamMuxers: [yamux()],
+    services: {
+      identify: identify(),
+      pairing: Libp2p.pairingService(
+        {
+          protocol: PAIRING_PROTOCOL,
+          pairedPeerTimeoutMs: options.pairedPeerTimeoutMs ?? 30 * 60 * 1000,
+        },
+        () => !selectedPeer,
+      ),
+      jsonRpc: Libp2p.jsonRpcService(
+        { protocol: JSON_RPC_PROTOCOL },
+        (request) => {
+          // Matches the CCC provider's caller-PeerID guard and generic error code.
+          if (
+            !node.services.pairing.isPaired(request.peerId) ||
+            !selectedPeer?.equals(request.peerId)
+          ) {
+            throw new ccc.JsonRpcError({
+              code: ccc.SignerJsonRpcErrorCode.ServerError,
+              message: "Peer is not paired for Khie access",
+            });
+          }
+          node.services.pairing.refresh(request.peerId);
+          stats.peers.push(request.peerId.toString());
+          stats.methods.push(request.payload.method);
+          // Deliberately do not abort wallet execution when only a stream closes.
+          return session.value.handle(request.payload);
+        },
+      ),
+    },
+  });
+  node.services.pairing.onPaired((peer) => {
+    selectedPeer = peer;
+  });
+  node.services.pairing.onUnpaired(() => {
+    stats.unpairs++;
+    void session.dispose();
+  });
+  const endpoint = await Libp2p.encodePairingEndpoint(
+    "khie-wallet://app/connect",
+    node.getMultiaddrs(),
+    node.services.pairing.secret,
+    "provider",
+  );
+  return {
+    node,
+    stats,
+    endpoint,
+    get selectedPeer() {
+      return selectedPeer;
+    },
+    releaseSignature() {
+      clearTimeout(signatureTimer);
+      releaseSignature?.();
+    },
+    async restartSession() {
+      await session.dispose();
+      session = createSession();
+    },
+    async stop() {
+      clearTimeout(signatureTimer);
+      releaseSignature?.();
+      await session.dispose();
+      await node.stop();
+    },
+  };
+}
diff --git a/packages/khie-mcp/src/transport.ts b/packages/khie-mcp/src/transport.ts
new file mode 100644
index 0000000..9e69647
--- /dev/null
+++ b/packages/khie-mcp/src/transport.ts
@@ -0,0 +1,146 @@
+import { noise } from "@chainsafe/libp2p-noise";
+import { yamux } from "@chainsafe/libp2p-yamux";
+import { ccc } from "@ckb-ccc/core";
+import { Libp2p } from "@ckb-ccc/libp2p";
+import { circuitRelayTransport } from "@libp2p/circuit-relay-v2";
+import { privateKeyFromProtobuf } from "@libp2p/crypto/keys";
+import { identify } from "@libp2p/identify";
+import type { Libp2p as Libp2pNode, PrivateKey } from "@libp2p/interface";
+import { peerIdFromString } from "@libp2p/peer-id";
+import { webSockets } from "@libp2p/websockets";
+import { multiaddr } from "@multiformats/multiaddr";
+import { createLibp2p } from "libp2p";
+import { randomUUID } from "node:crypto";
+import { BridgeError, type WalletState } from "./state.js";
+
+export const PAIRING_PROTOCOL = "/nervos-ckb/khie/pairing/0.0.1";
+export const JSON_RPC_PROTOCOL = "/nervos-ckb/khie/json-rpc/0.0.1";
+
+export type RequestMetadata = { request_id?: string; session_id?: string };
+export interface WalletConnection {
+  request(
+    method: string,
+    params: unknown[],
+    metadata: RequestMetadata,
+  ): Promise<unknown>;
+  /** MUST close transport only; never unpair, dispose provider state, or revoke. */
+  disconnectTransport(): Promise<void>;
+}
+export type WalletConnector = (state: WalletState) => Promise<WalletConnection>;
+
+/** Separate server factory: the existing interactive connector cleanup is unchanged. */
+export async function createBridgeNode(
+  privateKey: PrivateKey,
+): Promise<BridgeNode> {
+  const node = await createLibp2p({
+    start: false,
+    privateKey,
+    addresses: { listen: [] },
+    transports: [webSockets(), circuitRelayTransport()],
+    connectionEncrypters: [noise()],
+    streamMuxers: [yamux()],
+    services: {
+      identify: identify(),
+      pairing: Libp2p.pairingService(
+        {
+          protocol: PAIRING_PROTOCOL,
+          name: "Khie MCP prototype",
+          pairedPeerTimeoutMs: 30 * 60 * 1000,
+        },
+        () => false,
+      ),
+    },
+  });
+  try {
+    await node.start();
+    return node;
+  } catch (error) {
+    await disconnectNode(node);
+    throw error;
+  }
+}
+
+export type BridgeNode = Libp2pNode<{ pairing: Libp2p.PairingService }>;
+export type BridgeNodeFactory = (key: PrivateKey) => Promise<BridgeNode>;
+
+export function connectionFromNode(
+  node: BridgeNode,
+  walletPeerId: string,
+  timeout = 12_000,
+): WalletConnection {
+  const transport = new Libp2p.JsonRpcTransportLibp2p(
+    node,
+    peerIdFromString(walletPeerId),
+    {
+      protocol: JSON_RPC_PROTOCOL,
+      timeout,
+    },
+  );
+  return {
+    async request(method, params, metadata) {
+      const id = randomUUID();
+      const response = await transport.request({
+        jsonrpc: "2.0",
+        id,
+        method,
+        params: [metadata, ...params],
+      });
+      if (response.id !== id || response.jsonrpc !== "2.0") {
+        throw new Error("Invalid RPC envelope");
+      }
+      if ("error" in response && response.error) {
+        throw new ccc.JsonRpcError(response.error);
+      }
+      if (!("result" in response)) {
+        throw new Error("Missing RPC result");
+      }
+      return response.result;
+    },
+    // PairingService.stop clears only this node's timers. No remote unpair.
+    disconnectTransport: () => disconnectNode(node),
+  };
+}
+
+export function libp2pConnector(
+  factory: BridgeNodeFactory = createBridgeNode,
+  timeout = 12_000,
+): WalletConnector {
+  return async (state) => {
+    const key = privateKeyFromProtobuf(
+      Buffer.from(state.communicationKey, "base64"),
+    );
+    const node = await factory(key);
+    try {
+      const peer = peerIdFromString(state.walletPeerId);
+      const addresses = state.walletAddresses.map(multiaddr);
+      if (
+        addresses.length === 0 ||
+        addresses.some(
+          (address) =>
+            address.getComponents().at(-1)?.value !== peer.toString(),
+        )
+      ) {
+        throw new Error("Saved addresses must identify the pinned wallet peer");
+      }
+      await node.peerStore.merge(peer, { multiaddrs: addresses });
+      // Actual connection is made on demand by JsonRpcTransportLibp2p.
+      return connectionFromNode(node, state.walletPeerId, timeout);
+    } catch (error) {
+      await disconnectNode(node);
+      throw error;
+    }
+  };
+}
+
+export async function disconnectNode(node: BridgeNode) {
+  try {
+    await node.stop();
+    // libp2p may leave a failed startup cleanup in "stopping". A subsequent
+    // stop() then returns without doing anything; it is not proof of shutdown.
+    if (node.status !== "stopped") {
+      throw new BridgeError("transport_cleanup_failed");
+    }
+  } catch {
+    throw new BridgeError("transport_cleanup_failed");
+  }
+}
diff --git a/packages/khie-mcp/test/demo.test.mjs b/packages/khie-mcp/test/demo.test.mjs
new file mode 100644
index 0000000..408c25a
--- /dev/null
+++ b/packages/khie-mcp/test/demo.test.mjs
@@ -0,0 +1,101 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { mkdtemp, rm, stat } from "node:fs/promises";
+import { createServer } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+
+// Run after building: these checks deliberately cross the process boundary.
+const entry = new URL("../dist/demo.js", import.meta.url);
+
+function startDemo(directory) {
+  const child = spawn(process.execPath, [entry.pathname, directory], {
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  let stdout = "";
+  let stderr = "";
+  child.stdout.on("data", (data) => {
+    stdout += data;
+  });
+  child.stderr.on("data", (data) => {
+    stderr += data;
+  });
+  const timeout = setTimeout(() => child.kill("SIGKILL"), 20_000);
+  const exited = new Promise((resolve, reject) => {
+    child.once("error", reject);
+    child.once("close", (code, signal) => {
+      clearTimeout(timeout);
+      resolve({ code, signal, stdout, stderr });
+    });
+  });
+  return { child, exited };
+}
+
+test("occupied demo port removes all newly acquired temporary state", async () => {
+  const root = await mkdtemp(join(tmpdir(), "khie-demo-startup-test-"));
+  const directory = join(root, "demo");
+  const blocker = createServer();
+  let demo;
+  try {
+    await new Promise((resolve, reject) => {
+      blocker.once("error", reject);
+      blocker.listen(8787, "127.0.0.1", resolve);
+    });
+    demo = startDemo(directory);
+    const result = await demo.exited;
+    assert.equal(result.code, 1);
+    assert.equal(result.signal, null);
+    assert.match(result.stderr, /demo_setup_failed/);
+    assert.match(result.stdout, /temporary state removed/);
+    assert.doesNotMatch(result.stdout, /clientConfigFile/);
+    await assert.rejects(stat(directory), { code: "ENOENT" });
+  } finally {
+    demo?.child.kill("SIGTERM");
+    await demo?.exited;
+    if (blocker.listening) {
+      await new Promise((resolve) => blocker.close(resolve));
+    }
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("SIGTERM removes a running demo's credentials and closes its port", async () => {
+  const root = await mkdtemp(join(tmpdir(), "khie-demo-signal-test-"));
+  const directory = join(root, "demo");
+  const demo = startDemo(directory);
+  try {
+    await new Promise((resolve, reject) => {
+      let output = "";
+      demo.child.stdout.on("data", (data) => {
+        output += data;
+        if (output.includes("clientConfigFile")) resolve();
+      });
+      demo.child.once("close", () =>
+        reject(new Error("Demo exited before readiness")),
+      );
+      demo.child.once("error", reject);
+    });
+    const config = await stat(join(directory, "client.json"));
+    assert.equal(config.mode & 0o777, 0o600);
+    demo.child.kill("SIGTERM");
+    const result = await demo.exited;
+    assert.equal(result.code, 0);
+    assert.equal(result.signal, null);
+    assert.match(result.stdout, /temporary state removed/);
+    await assert.rejects(stat(directory), { code: "ENOENT" });
+    const probe = createServer();
+    try {
+      await new Promise((resolve, reject) => {
+        probe.once("error", reject);
+        probe.listen(8787, "127.0.0.1", resolve);
+      });
+    } finally {
+      if (probe.listening) await new Promise((resolve) => probe.close(resolve));
+    }
+  } finally {
+    demo.child.kill("SIGTERM");
+    await demo.exited;
+    await rm(root, { recursive: true, force: true });
+  }
+});
