+import { ccc } from "@ckb-ccc/core";
+import { createHash, randomUUID } from "node:crypto";
+import {
+  BridgeError,
+  METHODS,
+  validateOperationId,
+  type Method,
+  type Operation,
+  type Outcome,
+  type SecureStateStore,
+  type WalletState,
+} from "./state.js";
+import type { WalletConnection, WalletConnector } from "./transport.js";
+
+const MAX_OPERATIONS = 1024;
+
+export class KhieBridge {
+  constructor(
+    private readonly store: SecureStateStore,
+    private readonly connect: WalletConnector,
+  ) {}
+
+  async request(
+    principal: string,
+    handle: string,
+    operationId: string,
+    method: Method,
+    params: unknown[] = [],
+  ) {
+    validateOperationId(operationId);
+    validateRequest(method, params);
+    return this.store.withSession(principal, handle, async (state, save) => {
+      if (!state.allowedMethods.includes(method)) {
+        throw new BridgeError("method_not_allowed");
+      }
+      const fingerprint = payloadFingerprint(method, params);
+      const prior = getOperation(state, operationId);
+      if (prior && prior.fingerprint !== fingerprint) {
+        throw new BridgeError("operation_payload_mismatch");
+      }
+      if (state.phase !== "authorized") {
+        return { status: "repair_required" } as const;
+      }
+      return this.run(state, save, operationId, method, params);
+    });
+  }
+
+  async poll(principal: string, handle: string, operationId: string) {
+    validateOperationId(operationId);
+    return this.store.withSession(principal, handle, async (state, save) => {
+      const operation = getOperation(state, operationId);
+      if (!operation) {
+        throw new BridgeError("unknown_operation");
+      }
+      if (isTerminal(operation.outcome)) {
+        return operation.outcome;
+      }
+      if (state.phase !== "authorized") {
+        return { status: "repair_required" } as const;
+      }
+      return this.run(state, save, operationId);
+    });
+  }
+
+  /** Operator-only setup. Never registered as an MCP tool. */
+  authorize(principal: string, handle: string) {
+    return this.store.withSession(principal, handle, async (state, save) => {
+      if (state.phase === "authorized") {
+        return { status: "completed" };
+      }
+      if (state.phase !== "paired") {
+        return { status: "repair_required" };
+      }
+      if (!state.sessionId) {
+        const info = await this.run(state, save, "_info", "get_info", []);
+        if (info.status !== "completed") {
+          return withoutResult(info);
+        }
+        const result = info.result as { session_id?: unknown } | null;
+        if (
+          !result ||
+          typeof result.session_id !== "string" ||
+          !result.session_id
+        ) {
+          throw new BridgeError("invalid_wallet_info");
+        }
+        state.sessionId = result.session_id;
+        await save();
+      }
+      const outcome = await this.run(state, save, "_connect", "connect", [
+        state.networkId,
+      ]);
+      if (outcome.status === "completed") {
+        state.phase = "authorized";
+        await save();
+      }
+      // get_info/session metadata and arbitrary wallet errors never escape setup.
+      return withoutResult(outcome);
+    });
+  }
+
+  private async run(
+    state: WalletState,
+    save: () => Promise<void>,
+    operationId: string,
+    method?: string,
+    params: unknown[] = [],
+  ): Promise<Outcome> {
+    let operation = getOperation(state, operationId);
+    if (isTerminal(operation?.outcome)) {
+      return operation.outcome;
+    }
+    const firstAttempt = operation === undefined;
+    if (!operation) {
+      if (!method) {
+        throw new BridgeError("unknown_operation");
+      }
+      if (Object.keys(state.operations).length >= MAX_OPERATIONS) {
+        throw new BridgeError("operation_capacity_reached");
+      }
+      operation = {
+        fingerprint: payloadFingerprint(method, params),
+        requestId: randomUUID(),
+      };
+      state.operations[operationId] = operation;
+      // Write ahead even before dialing: crashes leave uncertainty, never a replay.
+      await save();
+    }
+    let connection: WalletConnection | undefined;
+    let outcome: Outcome;
+    try {
+      connection = await this.connect(state);
+      if (firstAttempt) {
+        try {
+          const result = await connection.request(method!, params, {
+            request_id: operation.requestId,
+            ...(method !== "get_info" ? { session_id: state.sessionId } : {}),
+          });
+          outcome = { status: "completed", result: result ?? null };
+        } catch (error) {
+          if (
+            error instanceof ccc.JsonRpcError &&
+            error.code === Number(ccc.SignerJsonRpcErrorCode.DuplicateRequestId)
+          ) {
+            outcome = await pollResult(connection, operation);
+          } else {
+            throw error;
+          }
+        }
+      } else {
+        outcome = await pollResult(connection, operation);
+      }
+    } catch (error) {
+      if (
+        error instanceof BridgeError &&
+        error.code === "transport_cleanup_failed"
+      ) {
+        throw error;
+      }
+      outcome = classifyError(error);
+      if (outcome.status === "repair_required") {
+        state.phase = "repair_required";
+      }
+    } finally {
+      if (connection) {
+        try {
+          await connection.disconnectTransport();
+        } catch {
+          throw new BridgeError("transport_cleanup_failed");
+        }
+      }
+    }
+    operation.outcome = outcome;
+    await save();
+    return outcome;
+  }
+}
+
+function withoutResult(outcome: Outcome) {
+  return outcome.status === "completed" ? { status: "completed" } : outcome;
+}
+
+function getOperation(state: WalletState, id: string) {
+  return Object.hasOwn(state.operations, id) ? state.operations[id] : undefined;
+}
+
+function isTerminal(
+  outcome: Outcome | undefined,
+): outcome is Extract<Outcome, { status: "completed" | "rejected" }> {
+  return outcome?.status === "completed" || outcome?.status === "rejected";
+}
+
+async function pollResult(
+  connection: WalletConnection,
+  operation: Operation,
+): Promise<Outcome> {
+  const result = await connection.request(
+    "get_result",
+    [operation.requestId],
+    {},
+  );
+  if (typeof result !== "object" || result === null || !("status" in result)) {
+    return { status: "unknown", reason: "invalid_response" };
+  }
+  if (result.status === "pending") {
+    return { status: "pending" };
+  }
+  if (result.status === "not_found") {
+    return { status: "unknown", reason: "not_found" };
+  }
+  if (result.status === "completed" && "result" in result) {
+    return { status: "completed", result: result.result };
+  }
+  return { status: "unknown", reason: "invalid_response" };
+}
+
+function classifyError(error: unknown): Outcome {
+  if (!(error instanceof ccc.JsonRpcError)) {
+    return { status: "unknown", reason: "transport" };
+  }
+  if (
+    error.code === Number(ccc.SignerJsonRpcErrorCode.InvalidSession) ||
+    error.code === Number(ccc.SignerJsonRpcErrorCode.InvalidState)
+  ) {
+    return { status: "repair_required" };
+  }
+  // Only recognized protocol rejections are terminal. Unknown/future error codes
+  // and generic peer-authorization/server failures cannot prove non-execution.
+  if (
+    [
+      ccc.SignerJsonRpcErrorCode.MethodNotFound,
+      ccc.SignerJsonRpcErrorCode.InvalidParams,
+      ccc.SignerJsonRpcErrorCode.NetworkMismatch,
+      ccc.SignerJsonRpcErrorCode.UserRejected,
+    ].includes(error.code)
+  ) {
+    return { status: "rejected", code: error.code };
+  }
+  return { status: "unknown", reason: "wallet_error" };
+}
+
+function validateRequest(method: Method, params: unknown[]) {
+  if (
+    !METHODS.includes(method) ||
+    !Array.isArray(params) ||
+    params.length !== (method === "sign_message" ? 1 : 0)
+  ) {
+    throw new BridgeError("invalid_request");
+  }
+  // Confirm/sign remain the wallet's responsibility; operator policy enables this.
+  if (method === "sign_message") {
+    const message = params[0] as { type?: unknown; value?: unknown } | null;
+    if (
+      !message ||
+      (message.type !== "string" && message.type !== "bytes") ||
+      typeof message.value !== "string"
+    ) {
+      throw new BridgeError("invalid_message");
+    }
+    if (
+      message.type === "bytes" &&
+      !/^0x([0-9a-fA-F]{2})*$/.test(message.value)
+    ) {
+      throw new BridgeError("invalid_message");
+    }
+  }
+}
+
+export function payloadFingerprint(method: string, params: unknown[]) {
+  return createHash("sha256")
+    .update(canonicalJson([method, params]))
+    .digest("hex");
+}
+
+function canonicalJson(value: unknown): string {
+  if (
+    value === null ||
+    typeof value === "string" ||
+    typeof value === "boolean" ||
+    (typeof value === "number" && Number.isFinite(value))
+  ) {
+    return JSON.stringify(value);
+  }
+  if (Array.isArray(value)) {
+    return `[${value.map(canonicalJson).join(",")}]`;
+  }
+  if (
+    typeof value === "object" &&
+    Object.getPrototypeOf(value) === Object.prototype
+  ) {
+    return `{${Object.keys(value)
+      .sort()
+      .map(
+        (key) =>
+          `${JSON.stringify(key)}:${canonicalJson((value as Record<string, unknown>)[key])}`,
+      )
+      .join(",")}}`;
+  }
+  throw new BridgeError("invalid_json");
+}
diff --git a/packages/khie-mcp/src/cli.ts b/packages/khie-mcp/src/cli.ts
new file mode 100644
index 0000000..bbcfa20
--- /dev/null
+++ b/packages/khie-mcp/src/cli.ts
@@ -0,0 +1,96 @@
+import { constants } from "node:fs";
+import { open } from "node:fs/promises";
+import { KhieBridge } from "./bridge.js";
+import { enroll } from "./enroll.js";
+import { httpListenHost } from "./listenHost.js";
+import { createHttpServer } from "./server.js";
+import { BridgeError, type Method } from "./state.js";
+import { FileSecureStateStore } from "./store.js";
+import { libp2pConnector } from "./transport.js";
+
+export async function readSecretFile(path: string) {
+  const file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try {
+    const stat = await file.stat();
+    if (
+      !stat.isFile() ||
+      stat.uid !== process.getuid?.() ||
+      (stat.mode & 0o077) !== 0
+    ) {
+      throw new BridgeError("unsafe_secret_file");
+    }
+    return (await file.readFile("utf8")).trim();
+  } finally {
+    await file.close();
+  }
+}
+
+async function main() {
+  const configFile = process.env.KHIE_CONFIG_FILE;
+  if (!configFile) {
+    throw new BridgeError("missing_config_file");
+  }
+  const config = JSON.parse(await readSecretFile(configFile)) as {
+    principal: string;
+    storeDirectory: string;
+    storeKeyFile: string;
+    tokenFile: string;
+    allowedHosts: string[];
+    port?: number;
+    listenHost?: string;
+    networkId?: string;
+    allowedMethods?: Method[];
+  };
+  const store = await FileSecureStateStore.open(
+    config.storeDirectory,
+    Buffer.from(await readSecretFile(config.storeKeyFile), "base64"),
+  );
+  const bridge = new KhieBridge(store, libp2pConnector());
+  const [command, argument] = process.argv.slice(2);
+  if (command === "enroll") {
+    if (!argument) {
+      throw new BridgeError("missing_endpoint_file");
+    }
+    const handle = await enroll(
+      store,
+      config.principal,
+      await readSecretFile(argument),
+      config.networkId ?? "ckb-testnet",
+      config.allowedMethods,
+    );
+    // Print the non-secret handle before approval so setup can be resumed.
+    console.log(JSON.stringify({ handle }));
+    console.log(
+      JSON.stringify(await bridge.authorize(config.principal, handle)),
+    );
+  } else if (command === "authorize") {
+    console.log(
+      JSON.stringify(await bridge.authorize(config.principal, argument)),
+    );
+  } else if (command === "serve") {
+    const server = createHttpServer(bridge, {
+      ...config,
+      bearerToken: await readSecretFile(config.tokenFile),
+    });
+    server.listen(config.port ?? 8787, httpListenHost(config.listenHost), () =>
+      console.log("Khie MCP HTTP listener ready"),
+    );
+    for (const signal of ["SIGINT", "SIGTERM"] as const) {
+      process.once(signal, () => {
+        server.close();
+      });
+    }
+  } else {
+    throw new BridgeError("use_enroll_authorize_or_serve");
+  }
+}
+
+// No raw errors: provisioning errors may contain endpoint or identity material.
+if (process.argv[1]?.endsWith("/cli.js")) {
+  void main().catch((error: unknown) => {
+    console.error(
+      error instanceof BridgeError ? error.code : "operator_action_failed",
+    );
+    process.exitCode = 1;
+  });
+}
diff --git a/packages/khie-mcp/src/demo.ts b/packages/khie-mcp/src/demo.ts
new file mode 100644
index 0000000..f7ea7be
--- /dev/null
+++ b/packages/khie-mcp/src/demo.ts
@@ -0,0 +1,131 @@
+import { randomBytes } from "node:crypto";
+import { mkdir, rm, writeFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { KhieBridge } from "./bridge.js";
+import { enroll } from "./enroll.js";
+import { httpListenHost } from "./listenHost.js";
+import { createHttpServer } from "./server.js";
+import { FileSecureStateStore } from "./store.js";
+import { createTestBridgeNode, createTestWallet } from "./testWallet.js";
+import { libp2pConnector } from "./transport.js";
+
+async function main() {
+  const directory = resolve(process.argv[2] ?? "/tmp/khie-mcp-demo");
+  // Refuse to overwrite or later delete a preexisting directory.
+  await mkdir(directory, { mode: 0o700 });
+  let wallet: Awaited<ReturnType<typeof createTestWallet>> | undefined;
+  let server: ReturnType<typeof createHttpServer> | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const controller = new AbortController();
+  let finish!: () => void;
+  const stopped = new Promise<void>((resolve) => {
+    finish = resolve;
+  });
+  const stop = () => {
+    controller.abort();
+    finish();
+  };
+  for (const signal of ["SIGINT", "SIGTERM"] as const) {
+    process.once(signal, stop);
+  }
+  const checkRunning = () => controller.signal.throwIfAborted();
+
+  try {
+    const key = randomBytes(32);
+    const token = randomBytes(32).toString("base64url");
+    const store = await FileSecureStateStore.open(`${directory}/state`, key);
+    checkRunning();
+    wallet = await createTestWallet({ signDelayMs: 25_000 });
+    checkRunning();
+    const handle = await enroll(
+      store,
+      "isolated-demo",
+      wallet.endpoint,
+      "ckb-testnet",
+      ["get_identity", "sign_message"],
+      createTestBridgeNode,
+    );
+    checkRunning();
+    const bridge = new KhieBridge(store, libp2pConnector(createTestBridgeNode));
+    const authorized = await bridge.authorize("isolated-demo", handle);
+    checkRunning();
+    if (authorized.status !== "completed") {
+      throw new Error("Demo authorization failed");
+    }
+    server = createHttpServer(bridge, {
+      principal: "isolated-demo",
+      bearerToken: token,
+      allowedHosts: ["127.0.0.1:8787", "localhost:8787"],
+    });
+    // Await errors such as EADDRINUSE inside the resource-cleanup scope.
+    await new Promise<void>((resolve, reject) => {
+      const listening = () => {
+        server!.off("error", reject);
+        resolve();
+      };
+      server!.once("error", reject);
+      server!.listen(
+        8787,
+        httpListenHost(process.env.KHIE_LISTEN_HOST),
+        listening,
+      );
+    });
+    checkRunning();
+    await writeFile(
+      `${directory}/client.json`,
+      JSON.stringify({ handle, token, endpoint: "http://127.0.0.1:8787/mcp" }),
+      { mode: 0o600 },
+    );
+    checkRunning();
+    console.log(
+      JSON.stringify({
+        demo: "synthetic wallet only",
+        clientConfigFile: `${directory}/client.json`,
+        lifetime: "five minutes or until SIGINT/SIGTERM",
+      }),
+    );
+    timer = setTimeout(stop, 5 * 60_000);
+    await stopped;
+  } catch (error) {
+    if (!controller.signal.aborted) {
+      throw error;
+    }
+  } finally {
+    clearTimeout(timer);
+    for (const signal of ["SIGINT", "SIGTERM"] as const) {
+      process.off(signal, stop);
+    }
+    try {
+      if (server?.listening) {
+        await new Promise<void>((resolve, reject) => {
+          server!.close((error) => (error ? reject(error) : resolve()));
+          server!.closeAllConnections();
+        });
+      }
+    } finally {
+      try {
+        await wallet?.stop();
+      } finally {
+        await rm(directory, { recursive: true, force: true });
+      }
+    }
+    console.log(
+      JSON.stringify({
+        demo: "stopped",
+        authorizations: wallet?.stats.authorizations ?? 0,
+        syntheticSignatures: wallet?.stats.signatures ?? 0,
+        cleanup: "temporary state removed",
+      }),
+    );
+  }
+}
+
+// Exit only after cleanup: the provider's existing result-cache timers otherwise
+// keep a demo process alive. Raw errors may contain private provisioning data.
+void main().then(
+  () => process.exit(0),
+  () => {
+    console.error("demo_setup_failed");
+    process.exit(1);
+  },
+);
diff --git a/packages/khie-mcp/src/enroll.ts b/packages/khie-mcp/src/enroll.ts
new file mode 100644
index 0000000..cb1937d
--- /dev/null
+++ b/packages/khie-mcp/src/enroll.ts
@@ -0,0 +1,51 @@
+import { Libp2p } from "@ckb-ccc/libp2p";
+import { generateKeyPair, privateKeyToProtobuf } from "@libp2p/crypto/keys";
+import type { Method, SecureStateStore, WalletState } from "./state.js";
+import {
+  createBridgeNode,
+  disconnectNode,
+  type BridgeNodeFactory,
+} from "./transport.js";
+
+/** Server-side provisioning only. Endpoint contains a secret; never pass via MCP. */
+export async function enroll(
+  store: SecureStateStore,
+  principal: string,
+  endpoint: string,
+  networkId: string,
+  allowedMethods: Method[] = [
+    "get_identity",
+    "get_native_address",
+    "get_scripts",
+  ],
+  factory: BridgeNodeFactory = createBridgeNode,
+) {
+  const target = await Libp2p.decodePairingEndpoint(endpoint, "provider");
+  const key = await generateKeyPair("Ed25519");
+  const state: WalletState = {
+    version: 1,
+    principal,
+    communicationKey: Buffer.from(privateKeyToProtobuf(key)).toString("base64"),
+    walletPeerId: "",
+    walletAddresses: target.addresses.map(String),
+    networkId,
+    phase: "pairing",
+    allowedMethods,
+    operations: {},
+  };
+  const handle = await store.create(state);
+  await store.withSession(principal, handle, async (saved, save) => {
+    const node = await factory(key);
+    try {
+      const peer = await node.services.pairing.pair(target, {
+        signal: AbortSignal.timeout(15_000),
+      });
+      saved.walletPeerId = peer.toString();
+      saved.phase = "paired";
+      await save();
+    } finally {
+      await disconnectNode(node);
+    }
+  });
+  return handle;
+}
